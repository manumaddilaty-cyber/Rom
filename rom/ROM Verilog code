module rom (
    input  wire [3:0] address,
    output reg  [7:0] data
);

    always @(*) begin
        case (address)
            4'h0: data = 8'hA1;
            4'h1: data = 8'hB2;
            4'h2: data = 8'hC3;
            4'h3: data = 8'hD4;
            4'h4: data = 8'hE5;
            4'h5: data = 8'hF6;
            4'h6: data = 8'h17;
            4'h7: data = 8'h28;
            4'h8: data = 8'h39;
            4'h9: data = 8'h4A;
            4'hA: data = 8'h5B;
            4'hB: data = 8'h6C;
            4'hC: data = 8'h7D;
            4'hD: data = 8'h8E;
            4'hE: data = 8'h9F;
            4'hF: data = 8'hF0;
            default: data = 8'h00;
        endcase
    end

endmodules