`timescale 1ns/1ps

module rom_tb;

    reg  [3:0] address;
    wire [7:0] data;

    rom uut (
        .address(address),
        .data(data)
    );

    integer i;

    initial begin
        $dumpfile("sim/wave.vcd");
        $dumpvars(0, rom_tb);

        $display("ROM Simulation Started");
        $display("----------------------");

        for (i = 0; i < 16; i = i + 1) begin
            address = i;
            #10;
            $display("Address = %h, Data = %h", address, data);
        end

        $display("----------------------");
        $display("ROM Simulation Finished");

        $finish;
    end

endmodule