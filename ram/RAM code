module ram (
    input        clk,
    input        we,
    input  [3:0]  addr,
    input  [7:0]  data_in,
    output reg [7:0] data_out
);

    // 16 memory locations, each 8 bits wide
    reg [7:0] memory [0:15];

    // Write operation
    always @(posedge clk) begin
        if (we)
            memory[addr] <= data_in;
    end

    // Read operation
    always @(*) begin
        data_out = memory[addr];
    end

endmodule