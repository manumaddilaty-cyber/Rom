module ram (
    input        clk,
    input        we,
    input  [3:0]  address,
    input  [7:0]  data_in,
    output [7:0]  data_out
);

    // 16 locations, 8 bits per location
    reg [7:0] memory [0:15];

    // Write operation
    always @(posedge clk) begin
        if (we)
            memory[address] <= data_in;
    end

    // Read operation
    assign data_out = memory[address];

endmodule