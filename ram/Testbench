`timescale 1ns/1ps

module ram_tb;

    reg clk;
    reg we;
    reg [3:0] address;
    reg [7:0] data_in;
    wire [7:0] data_out;

    // RAM instantiation
    ram uut (
        .clk(clk),
        .we(we),
        .address(address),
        .data_in(data_in),
        .data_out(data_out)
    );

    // Clock generation
    always #5 clk = ~clk;

    initial begin

        // Generate waveform
        $dumpfile("simulation/waveform.vcd");
        $dumpvars(0, ram_tb);

        // Initial values
        clk = 0;
        we = 0;
        address = 0;
        data_in = 0;

        // -------------------------
        // WRITE DATA
        // -------------------------

        // Write 55 to address 0
        #10;
        we = 1;
        address = 4'd0;
        data_in = 8'h55;

        #10;

        // Write AA to address 1
        address = 4'd1;
        data_in = 8'hAA;

        #10;

        // Write F0 to address 2
        address = 4'd2;
        data_in = 8'hF0;

        #10;

        // Stop writing
        we = 0;

        // -------------------------
        // READ DATA
        // -------------------------

        // Read address 0
        address = 4'd0;
        #5;
        $display("Address = %d, Data = %h", address, data_out);

        // Read address 1
        address = 4'd1;
        #5;
        $display("Address = %d, Data = %h", address, data_out);

        // Read address 2
        address = 4'd2;
        #5;
        $display("Address = %d, Data = %h", address, data_out);

        // Read address 3
        address = 4'd3;
        #5;
        $display("Address = %d, Data = %h", address, data_out);

        #10;

        $finish;
    end

endmodules